# Base URL of the Integryl Intelligence publication on Beehiiv.
# Defaults to https://integryl-intelligence.beehiiv.com when unset.
NEXT_PUBLIC_INTELLIGENCE_URL=

# Set to "true" when Integryl Intelligence has published its first edition.
# Until then the site shows it as coming soon and links only to the subscribe page.
NEXT_PUBLIC_INTELLIGENCE_LIVE=

# RSS feed read by the latest-edition card on the home page. Optional: the card falls back when unset.
BEEHIIV_RSS_URL=https://rss.beehiiv.com/feeds/99U4VyDPfu.xml

# Engage form delivery through Resend. All three are required for the form to send.
RESEND_API_KEY=
ENGAGE_TO_EMAIL=hello@integryl.com
ENGAGE_FROM_EMAIL=Integryl Website <engage@notify.integryl.com>
